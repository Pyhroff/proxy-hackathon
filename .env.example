# Copy to .env and fill in real values. Never commit the real .env.

# Layer-2 injection scanner (policy/scanner.py) -- required to activate
# the LLM-judge check. Without this set, the scanner runs heuristic-only
# (still functional, just lower recall on subtle injections).
GROQ_API_KEY=

# Agent reasoning LLM (Person 2's module -- listed here for convenience
# since both keys usually get set together during setup).
ANTHROPIC_API_KEY=
